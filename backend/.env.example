# ============================================================
# INSTITUTO TÉCNICO INDUSTRIAL SANTANDER
# Revista Digital — Variables de Entorno
# Copiar a .env y llenar los valores reales
# NUNCA subir .env al repositorio
# ============================================================

# ── App ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# ── JWT ──────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar_por_secreto_seguro_minimo_64_caracteres

# ── Anthropic IA ─────────────────────────────────────────
# Obtener en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL_NOTICIAS=claude-sonnet-4-5
CLAUDE_MODEL_IMAGENES=claude-haiku-4-5-20251001

# ── Base de datos ─────────────────────────────────────────
# Desarrollo: SQLite (no necesita servidor)
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Producción: PostgreSQL en Supabase (gratis)
# DB_DIALECT=postgres
# DB_HOST=db.xxxx.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=tu_password_supabase

# ── Cloudinary (imágenes) ─────────────────────────────────
# Obtener en: https://cloudinary.com (plan gratis = 25 GB)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── Email (Gmail SMTP gratuito) ───────────────────────────
# Activar "Contraseñas de aplicación" en tu cuenta Gmail:
# myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de app
EMAIL_USER=institutotecnicosantander@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM=Instituto Técnico Industrial Santander <institutotecnicosantander@gmail.com>

# ── Admin inicial (seed) ──────────────────────────────────
ADMIN_EMAIL=admin@itssantander.edu.co
ADMIN_PASSWORD=Admin2024*

# ── Super Admin (Ronald — Director del proyecto) ─────────
# Ejecutar UNA VEZ: node src/utils/seed-super-admin.js
SUPER_ADMIN_EMAIL=tu_email@gmail.com
SUPER_ADMIN_PASSWORD=tu_clave_aqui
SUPER_ADMIN_NOMBRE=Ronald Medina

# ── Dominio (cuando lo tengan) ────────────────────────────
# DOMAIN=institutotecnicosantander.com.co
